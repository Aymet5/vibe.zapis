# Скопируйте этот файл в .env и заполните значения на своём сервере.
# Файл .env в git не попадает — секреты остаются только на сервере.
# cp .env.example .env && nano .env

# ─────────────────────────────────────────────
# Основное
# ─────────────────────────────────────────────

# Порт, на котором слушает сервер. Наружу его обычно проксирует nginx.
PORT=3001

# Публичный адрес сайта без слэша на конце.
# Используется в redirect_uri для ВК и в ссылках внутри сообщений бота.
APP_URL=https://vibe-kyzyl.ru

# Ключ подписи сессионных кук. Обязателен в production.
# Сгенерировать: openssl rand -hex 32
# Если поменять — все клиенты разлогинятся.
SESSION_SECRET=

# Файл базы данных SQLite. Каталог создаётся автоматически.
# ВАЖНО: включите этот файл в резервное копирование — в нём накопленные скидки клиентов.
DATABASE_PATH=./data/vibe.sqlite

# Пароль ко входу в панель управления (/admin).
# Без него панель недоступна вообще.
ADMIN_PASSWORD=

# ─────────────────────────────────────────────
# Вход через ВКонтакте (VK ID)
# ─────────────────────────────────────────────
# Где взять: создайте приложение на https://id.vk.com/about/business/go
# (тип «Веб-сайт») и в настройках укажите:
#   Базовый домен:       vibe-kyzyl.ru
#   Доверенный redirect: https://vibe-kyzyl.ru/api/auth/vk/callback
# Без этих двух ключей кнопка входа на сайте не показывается.

VK_APP_ID=
VK_APP_SECRET=

# ─────────────────────────────────────────────
# Бот сообщества ВКонтакте (подтверждения и напоминания)
# ─────────────────────────────────────────────
# Сообщество -> Управление -> Работа с API.
#
# 1) «Ключи доступа» -> создать ключ с правами «Сообщения сообщества».
VK_GROUP_TOKEN=

# 2) Числовой id сообщества (Управление -> Адрес страницы, либо vk.com/club123456789).
#    Указывать без минуса.
VK_GROUP_ID=

# 3) Callback API -> версия 5.199, адрес сервера:
#       https://vibe-kyzyl.ru/api/vk/callback
#    ВК покажет строку для подтверждения — впишите её сюда, перезапустите сервер
#    и только потом нажмите «Подтвердить» в настройках сообщества.
VK_CALLBACK_CONFIRMATION=

# 4) Там же задайте «Секретный ключ» и продублируйте его здесь.
#    Сервер отклоняет события без совпадающего ключа.
VK_CALLBACK_SECRET=

# 5) В разделе «Типы событий» включите:
#       Входящее сообщение, Событие в сообщении (callback-кнопки),
#       Разрешение на сообщения, Запрет на сообщения.
#    И в настройках сообщения от сообщества должны быть включены.

# Версия API ВКонтакте. Менять обычно не нужно.
VK_API_VERSION=5.199

# ─────────────────────────────────────────────
# Уведомления администраторам в Telegram
# ─────────────────────────────────────────────
# Токен нового бота у @BotFather. Старый токен лежал в коде сайта и утёк —
# его нужно отозвать. Теперь сообщения отправляет только сервер.
TELEGRAM_BOT_TOKEN=

# Чаты, куда падают новые записи. Через запятую, id группы — с минусом.
TELEGRAM_CHAT_IDS=

# ─────────────────────────────────────────────
# Расписание и напоминания
# ─────────────────────────────────────────────

# За сколько часов до визита бот присылает напоминание.
REMINDER_HOURS_BEFORE=3

# Часовой пояс салона в минутах от UTC. Кызыл — UTC+7, то есть 420.
# От него зависит, что считается «сегодня» и когда слать напоминания.
SALON_UTC_OFFSET_MINUTES=420
